  "scripts": {
    "start": "webpack serve --port 8080 --env isLocal",
    "lint": "eslint src --ext js,ts,tsx",
    "test": "cross-env BABEL_ENV=test jest --forceExit --runInBand --coverage",
    "coverage": "cross-env BABEL_ENV=test jest --forceExit --runInBand --coverage",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "prepare": "cd .. && husky install ./sip-rootconfig-ui-mf/.husky",
    "build:webpack": "webpack --mode=production",
    "build:types": "tsc",
    "build": "concurrently npm:build:*",
    "build:dev": "webpack --mode=production --env environment=dev && tsc",
    "build:qa": "webpack --mode=production --env environment=qa && tsc",
    "build:prod": "webpack --mode=production --env environment=prod && tsc",
    "test:e2e": "echo Your script goes here to test e2e"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
